# Copy to .env and fill in. Never commit .env.

# Required: Tier 3 synthesis (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: extra keys rotated in on 429 / quota errors
GEMINI_FB1_API_KEY=
GEMINI_FB2_API_KEY=

# Optional: pin a model (default chain: gemini-3.8-flash -> 3.7 -> 3.6 -> 3.5 -> flash-latest -> 3.5-flash-lite)
GEMINI_MODEL=

# Strongly recommended: Tier 2 doc search (https://tavily.com)
TAVILY_API_KEY=

# Optional: Tier 2 deep-scrape fallback when search excerpts are thin (https://firecrawl.dev)
FIRECRAWL_API_KEY=
